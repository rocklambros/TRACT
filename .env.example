# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Address the API server binds to.
# Use 127.0.0.1 for local development.
# Change to 0.0.0.0 only when intentionally exposing the API.
TRACT_API_HOST=127.0.0.1

# Port the API listens on.
TRACT_API_PORT=8000

# Number of Uvicorn worker processes.
# GPU deployments should typically keep this at 1.
TRACT_API_WORKERS=1

# Directory containing deployment model artifacts.
TRACT_API_MODEL_DIR=results/phase1c/deployment_model/

# Version string returned by the API.
TRACT_API_MODEL_VERSION=tract-cre-assignment-v1.0

# Comma-separated list of allowed CORS origins.
# "*" allows every origin and is appropriate only for development.
TRACT_API_CORS_ORIGINS=*

# Maximum number of controls accepted by /assign/batch.
TRACT_API_MAX_BATCH_SIZE=256

# Maximum control text length.
TRACT_API_MAX_TEXT_LENGTH=8192

# Maximum HTTP request body size in bytes.
TRACT_API_MAX_BODY_BYTES=4194304

# Shared-secret authentication token.
# Leave empty for localhost development.
# Required when binding to any non-loopback interface.
# Example generation:
# python -c "import secrets; print(secrets.token_hex(32))"
TRACT_API_AUTH_TOKEN=

# Optional JSONL audit log destination.
# Example:
# /tmp/audit.jsonl
TRACT_API_AUDIT_LOG=